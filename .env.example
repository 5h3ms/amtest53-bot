# Copy to .env.local and enter values locally. Never commit .env.local.
BOT_TOKEN=
# Run npm run identify, send /start, and use the printed numeric Telegram ID.
ALLOWED_USER_IDS=
ADMIN_USER_IDS=
# file (default, simplest local start) or firestore (emulator only).
LOCAL_STORAGE=file
# Only needed for LOCAL_STORAGE=firestore:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GCLOUD_PROJECT=demo-amtest53-bot
